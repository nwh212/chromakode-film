{
  "id": "io.github.nwh212.chromagold",
  "name": "ChromaGold 200",
  "version": "@version",
  "kind": "filter",
  "stage": "display",
  "description": "Kodak Gold 200 colour negative film, printed: a physical model of the C-41 negative and its print from Kodak's data sheet, with golden yellows and oranges, deep carmine reds, olive greens, dense warm shadows and highlights that hold, and the film's soft grain, halation and softness. Exposure shifts the negative as a real under- or over-exposure would. Meant for the Display stage.",
  "author": "nwh212",
  "homepage": "https://github.com/nwh212/chromakode-film",
  "repository": "https://github.com/nwh212/chromakode-film",
  "changelog": "https://github.com/nwh212/chromakode-film/blob/main/CHANGELOG.md",
  "license": "MIT",
  "icon": "@icon",
  "header": {
    "dark": "@header_dark",
    "light": "@header_light"
  },
  "overlap": 24,
  "params": {
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "default": 100
    },
    "normalize": {
      "type": "bool",
      "label": "Normalize",
      "default": false
    },
    "bypass": {
      "type": "bool",
      "label": "Base only",
      "default": false
    },
    "grain": {
      "type": "number",
      "label": "Grain",
      "min": 0,
      "max": 100,
      "default": 55
    },
    "halation": {
      "type": "number",
      "label": "Halation",
      "min": 0,
      "max": 100,
      "default": 30
    },
    "softness": {
      "type": "number",
      "label": "Softness",
      "min": 0,
      "max": 100,
      "default": 30
    },
    "denoise": {
      "type": "choice",
      "label": "Denoise",
      "options": [
        "Off",
        "Light",
        "Medium",
        "Strong",
        "Max"
      ],
      "default": "Off"
    },
    "exposure": {
      "type": "number",
      "label": "Exposure",
      "min": -2,
      "max": 3,
      "default": 0
    },
    "sunCast": {
      "type": "number",
      "label": "Sun Cast",
      "min": 0,
      "max": 100,
      "default": 0
    },
    "liftedFade": {
      "type": "bool",
      "label": "Lifted Fade",
      "default": false
    },
    "bandingFix": {
      "type": "bool",
      "label": "Banding Fix",
      "default": false
    }
  },
  "sections": [
    {
      "label": "Film",
      "params": [
        "grain",
        "halation",
        "softness"
      ]
    },
    {
      "label": "Before the look",
      "params": [
        "denoise"
      ]
    },
    {
      "label": "The negative",
      "params": [
        "exposure",
        "sunCast"
      ]
    },
    {
      "label": "After the look",
      "params": [
        "liftedFade",
        "bandingFix"
      ]
    }
  ]
}
